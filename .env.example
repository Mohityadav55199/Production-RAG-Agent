# ==============================================================================
# 🚀 PRODUCTION RAG AGENT — HOW TO RUN & CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env.local` to configure your Next.js frontend:
#
# QUICK START GUIDE:
# ------------------------------------------------------------------------------
# You need TWO separate terminals running at the same time:
#
# 1️⃣ TERMINAL 1 (Backend - FastAPI):
#    cd backend
#    .\.venv\Scripts\activate
#    uvicorn app.main:app --reload --port 8000
#
#    * Note: On startup, it checks Postgres tables & Qdrant collections.
#      Wait ~30s until you see: "Application startup complete. Uvicorn running on http://127.0.0.1:8000"
#
# 2️⃣ TERMINAL 2 (Frontend - Next.js):
#    npm run dev -- -p 3001
#    (or simply `npm run dev` if port 3000 is free)
#
# 3️⃣ BROWSER:
#    Open: http://localhost:3001/login
#
# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================

# Option 1: Local Backend (Default & Active)
# Next.js will proxy all /api/* requests to your local FastAPI backend:
BACKEND_URL=http://127.0.0.1:8000

# Option 2: Live Cloud Backend on Render
# If you don't want to run the backend locally, comment out Option 1 above
# and uncomment the line below:
# BACKEND_URL=https://production-rag-agent.onrender.com

# Optional client-side API override (defaults to Next.js /api proxy rewrite)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
