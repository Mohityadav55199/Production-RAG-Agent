# ─────────────────────────────────────────────────────────────────────────────
# RAG Agent — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="RAG Agent API"
APP_VERSION="0.1.0"
ENVIRONMENT=development         # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=20

# ── RAG retrieval ──────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
MAX_HISTORY_PAIRS=5

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Option A: Full Connection URL (e.g. Neon.tech, Supabase, Render Postgres, Railway)
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Individual connection parameters
POSTGRES_HOST=localhost          # 'postgres' inside Docker, 'localhost' for local dev
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb

# ── Qdrant ─────────────────────────────────────────────────────────────────────
# Option A: Cloud Cluster URL (e.g. https://xyz.us-east-1.aws.cloud.qdrant.io:6333)
# QDRANT_URL=https://your-cluster-id.us-east-1.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# Option B: Host & Port (e.g. local or docker)
QDRANT_HOST=localhost              # 'qdrant' inside Docker, 'localhost' for local dev
QDRANT_PORT=6333
QDRANT_API_KEY=                  # leave blank for self-hosted; required for Qdrant Cloud
QDRANT_COLLECTION=documents

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins; use * for development only
CORS_ORIGINS=["*"]

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Accounts / login ─────────────────────────────────────────────────────────
# Long random string used to sign login tokens. REQUIRED in production
# (generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))").
# If unset, a random one is used and everyone is logged out on every restart.
JWT_SECRET=
# Reverse proxies in front of the app (Render = 1). Used to find the real client address for login
# rate limiting. If your logs show every user sharing one IP, raise it; never set it higher than needed.
TRUSTED_PROXY_HOPS=1
# Set to false to close registration once your accounts exist
ALLOW_SIGNUP=true
# The first account ever registered is the administrator (the only one who can use the shared
# /collections admin endpoints), so register your own account first.
# Tailoring runs allowed per user per 24h
RESUME_DAILY_LIMIT=20

# Optional: GitHub token for importing private repos / higher rate limits
GITHUB_TOKEN=
